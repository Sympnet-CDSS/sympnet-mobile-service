<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#009688"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="40dp"
            android:paddingTop="28dp">

            <!-- Bouton retour -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:layout_gravity="start"
                android:padding="6dp"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF" />

            <!-- Logo -->
            <FrameLayout
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginTop="8dp">

                <View
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="#FFFFFF" />

                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_help"
                    app:tint="#009688" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Aide &amp; Support"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Besoin d'assistance ?"
                android:textColor="#E0F2F1"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- BODY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif-medium"
                android:text="Comment pouvons-nous vous aider ?"
                android:textColor="#1A2A3A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Chat Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChatSupport"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:text="Chat en direct"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:backgroundTint="#009688"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_chat"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="#FFFFFF" />

            <!-- Email Button -->
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btnEmailSupport"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:text="Envoyer un email"
                android:textColor="#009688"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_dialog_email"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="#009688"
                app:strokeColor="#009688"
                app:strokeWidth="1.5dp" />

            <!-- Phone Button -->
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btnPhoneSupport"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="32dp"
                android:text="Appeler le support"
                android:textColor="#009688"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_phone"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="#009688"
                app:strokeColor="#009688"
                app:strokeWidth="1.5dp" />

            <!-- FAQ Section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_description"
                    app:tint="#009688" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Questions Fréquentes"
                    android:textColor="#1A2A3A"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- FAQ Items -->
            <include layout="@layout/item_faq" />
            <include layout="@layout/item_faq" />
            <include layout="@layout/item_faq" />
            <include layout="@layout/item_faq" />
            <include layout="@layout/item_faq" />

            <!-- Voir toutes les questions -->
            <TextView
                android:id="@+id/tvViewAllFaq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Voir toutes les questions →"
                android:textColor="#009688"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>