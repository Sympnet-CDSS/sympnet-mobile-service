<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/onboarding_icon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_diagnostic"
        app:tint="@color/teal_500" />

    <TextView
        android:id="@+id/onboarding_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Diagnostic Intelligent"
        android:textColor="@color/gray_900"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/onboarding_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="5 agents IA analysent vos symptômes..."
        android:textColor="@color/gray_600"
        android:textSize="16sp" />

</LinearLayout>