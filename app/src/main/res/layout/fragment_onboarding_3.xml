<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onboarding_bg_3">

    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-50dp"
        android:layout_marginBottom="80dp"
        android:alpha="0.07"
        android:background="@drawable/shape_circle_white" />

    <View
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        android:alpha="0.05"
        android:background="@drawable/shape_circle_white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginBottom="48dp">

            <View
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:alpha="0.15"
                android:background="@drawable/shape_circle_white" />

            <!-- ic_calendar : Vector Asset "event" depuis Material Icons -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_calendar"
                android:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/shape_tag_white"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="SUIVI · RAPPELS · HISTORIQUE"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Suivi Médical\nComplet"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp" />

        <View
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/shape_divider_white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="Gérez vos rendez-vous, consultez votre historique médical et recevez des rappels pour vos prochaines consultations."
            android:textColor="#CCffffff"
            android:textSize="15sp" />

    </LinearLayout>

</FrameLayout>