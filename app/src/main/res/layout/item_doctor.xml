<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_background"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Photo du médecin -->
    <ImageView
        android:id="@+id/docImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/circle_background"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_doctor_avatar" />

    <!-- Infos + boutons -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Nom -->
        <TextView
            android:id="@+id/docName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dr. Mohamed Ben Ali"
            android:textColor="#0D6E6A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Spécialité -->
        <TextView
            android:id="@+id/docSpecialty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Cardiologie"
            android:textColor="#444"
            android:textSize="13sp" />

        <!-- Boutons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Bouton Info -->
            <TextView
                android:id="@+id/btnInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_green"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="Info"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Bouton Calendrier -->
            <TextView
                android:id="@+id/btnCalendar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_green_outline"
                android:gravity="center"
                android:text="📅"
                android:textSize="14sp" />

            <!-- Bouton Info (i) -->
            <TextView
                android:id="@+id/btnInfoCircle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_green_outline"
                android:gravity="center"
                android:text="i"
                android:textColor="#0D6E6A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Bouton Question -->
            <TextView
                android:id="@+id/btnQuestion"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_green_outline"
                android:gravity="center"
                android:text="?"
                android:textColor="#0D6E6A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Bouton Favori -->
            <TextView
                android:id="@+id/btnFavorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_green_outline"
                android:gravity="center"
                android:text="♡"
                android:textColor="#0D6E6A"
                android:textSize="14sp" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>