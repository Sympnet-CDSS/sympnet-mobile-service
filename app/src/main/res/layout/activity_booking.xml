<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#009688" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/search_bg"
            android:backgroundTint="#009688"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:text="Dr. Olivia Turner, M.D."
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:src="@android:drawable/ic_menu_call"
                app:tint="#009688" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/presence_video_online"
                app:tint="#009688" />
        </LinearLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:layout_below="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Month"
                android:textColor="#009688"
                android:textStyle="bold" />

            <!-- Horizontal Calendar Strip -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <include layout="@layout/item_calendar_day_v2" />
                    <include layout="@layout/item_calendar_day_v2" />
                    <include layout="@layout/item_calendar_day_v2_selected" />
                    <include layout="@layout/item_calendar_day_v2" />
                    <include layout="@layout/item_calendar_day_v2" />
                    <include layout="@layout/item_calendar_day_v2" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Available Time"
                android:textColor="#009688"
                android:textStyle="bold" />

            <!-- Time Slots Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="4"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <TextView style="@style/TimeSlotStyle" android:text="9:00 AM" />
                <TextView style="@style/TimeSlotStyle" android:text="9:30 AM" />
                <TextView style="@style/TimeSlotStyleSelected" android:text="10:00 AM" />
                <TextView style="@style/TimeSlotStyle" android:text="10:30 AM" />

                <TextView style="@style/TimeSlotStyle" android:text="11:00 AM" />
                <TextView style="@style/TimeSlotStyle" android:text="11:30 AM" />
                <TextView style="@style/TimeSlotStyle" android:text="12:00 PM" />
                <TextView style="@style/TimeSlotStyle" android:text="12:30 PM" />

                <TextView style="@style/TimeSlotStyle" android:text="1:00 PM" />
                <TextView style="@style/TimeSlotStyle" android:text="1:30 PM" />
                <TextView style="@style/TimeSlotStyle" android:text="2:00 PM" />
                <TextView style="@style/TimeSlotStyle" android:text="2:30 PM" />

                <TextView style="@style/TimeSlotStyle" android:text="3:00 PM" />
                <TextView style="@style/TimeSlotStyle" android:text="3:30 PM" />
                <TextView style="@style/TimeSlotStyle" android:text="4:00 PM" />
            </GridLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Patient Details"
                android:textColor="#009688"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yourself"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/search_bg"
                    android:backgroundTint="#F5F5F5"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Another Person"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/search_bg"
                    android:backgroundTint="#009688"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/search_bg"
                android:backgroundTint="#F5F5F5"
                android:hint="Full Name"
                android:text="Jane Doe"
                android:paddingHorizontal="16dp"
                android:textSize="14sp" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/search_bg"
                android:backgroundTint="#F5F5F5"
                android:hint="Age"
                android:text="30"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Male"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:background="@drawable/search_bg"
                    android:backgroundTint="#F5F5F5"
                    android:textColor="#9E9E9E"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Female"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:background="@drawable/search_bg"
                    android:backgroundTint="#009688"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Other"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:background="@drawable/search_bg"
                    android:backgroundTint="#F5F5F5"
                    android:textColor="#9E9E9E"/>
            </LinearLayout>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/search_bg"
                android:backgroundTint="#F5F5F5"
                android:gravity="top"
                android:hint="Enter Your Problem Here..."
                android:padding="16dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnConfirmBooking"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#009688"
                android:text="Confirm Appointment"
                android:textAllCaps="false"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="#009688"
        android:gravity="center"
        android:padding="14dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_home"
            app:tint="#FFFFFF" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="40dp"
            android:src="@drawable/ic_chat"
            app:tint="#B2DFDB" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="40dp"
            android:src="@drawable/ic_profile"
            app:tint="#B2DFDB" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="40dp"
            android:src="@drawable/ic_calendar"
            app:tint="#B2DFDB" />
    </LinearLayout>

</RelativeLayout>
