<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FBFF"
    android:orientation="vertical">

    <!-- ── HEADER ── -->
    <RelativeLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#009688"
        android:paddingHorizontal="12dp">

        <!-- Back button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <!-- Doctor avatar -->
        <ImageView
            android:id="@+id/ivDoctorAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/btnBack"
            android:background="@drawable/circle_background"
            android:backgroundTint="#B2DFDB"
            android:padding="2dp"
            android:src="@drawable/ic_profile_avatar" />

        <!-- Doctor name + status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/headerActions"
            android:layout_toEndOf="@id/ivDoctorAvatar"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDoctorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Olivia Turner"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="#A5D6A7"
                    android:layout_marginEnd="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online"
                    android:textColor="#B2DFDB"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Call + Video icons -->
        <LinearLayout
            android:id="@+id/headerActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnCall"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#00897B"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_call"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/btnVideo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#00897B"
                android:padding="9dp"
                android:src="@android:drawable/presence_video_online"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </RelativeLayout>

    <!-- ── MESSAGES ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:scrollbars="none" />

    <!-- ── INPUT AREA ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Attachment -->
        <ImageView
            android:id="@+id/btnAttach"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="#E0F2F1"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_share"
            app:tint="#009688" />

        <!-- Text input -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            app:boxCornerRadiusBottomEnd="24dp"
            app:boxCornerRadiusBottomStart="24dp"
            app:boxCornerRadiusTopEnd="24dp"
            app:boxCornerRadiusTopStart="24dp"
            app:boxStrokeColor="#E0F2F1"
            app:boxStrokeWidth="1dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Write a message…"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Voice note -->
        <ImageView
            android:id="@+id/btnVoice"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="#E0F2F1"
            android:padding="9dp"
            android:src="@android:drawable/ic_btn_speak_now"
            app:tint="#009688" />

        <!-- Send button -->
        <ImageView
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="#009688"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_send"
            app:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>