<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:layout_marginHorizontal="20dp"
    android:layout_marginBottom="20dp"
    android:background="@drawable/bg_navbar_modern"
    android:elevation="10dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp">

    <!-- Home Item -->
    <LinearLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/nav_home_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_home"
            app:tint="#009688" />
        <View
            android:id="@+id/home_indicator"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="#009688" />
    </LinearLayout>

    <!-- Chat Item -->
    <LinearLayout
        android:id="@+id/nav_chat"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/nav_chat_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_chat"
                app:tint="#999999" />
            <View
                android:id="@+id/nav_chat_badge"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-1dp"
                android:layout_marginEnd="-1dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#FF5252"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- AI Chatbot Center Button (Prominent) -->
    <FrameLayout
        android:id="@+id/nav_ai"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2">
        <ImageView
            android:id="@+id/nav_ai_icon"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:background="@drawable/circle_background"
            android:backgroundTint="#009688"
            android:elevation="4dp"
            android:padding="14dp"
            android:src="@android:drawable/ic_menu_help"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <!-- Calendar Item -->
    <LinearLayout
        android:id="@+id/nav_calendar"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/nav_calendar_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_calendar"
            app:tint="#999999" />
    </LinearLayout>

    <!-- Profile Item -->
    <LinearLayout
        android:id="@+id/nav_profile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/nav_profile_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_profile"
            app:tint="#999999" />
    </LinearLayout>

</LinearLayout>