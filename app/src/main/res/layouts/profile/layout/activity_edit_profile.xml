<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00796B"
    android:orientation="vertical">

    <!-- HEADER -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#00796B"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btnBack"
            android:layout_marginStart="12dp"
            android:text="Modifier le profil"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- SCROLLABLE BODY -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- SECTION AVATAR -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="24dp">

                    <!-- Avatar + bouton caméra -->
                    <RelativeLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp">
                        <ImageView
                            android:id="@+id/ivProfileImage"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#E0F2F1"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="2dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_profile_avatar" />
                        <LinearLayout
                            android:id="@+id/btnChangePhoto"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#009688"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@android:drawable/ic_menu_camera"
                                app:tint="#FFFFFF" />
                        </LinearLayout>
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Yasmine Ouertani"
                        android:textColor="#1A2A3A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="ouertaniyassmine10@gmail.com"
                        android:textColor="#7A8A9A"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvChangePhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="Changer la photo de profil"
                        android:textColor="#009688"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECTION : INFORMATIONS PERSONNELLES -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="#009688" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="INFORMATIONS PERSONNELLES"
                            android:textColor="#00796B"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <!-- Prénom + Nom côte à côte -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:orientation="horizontal">

                        <!-- Prénom -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                    android:src="@android:drawable/ic_menu_myplaces" app:tint="#009688"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp" android:text="Prénom"
                                    android:textColor="#009688" android:textSize="12sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <EditText
                                android:id="@+id/etFirstName"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/search_bg"
                                android:backgroundTint="#F5F5F5"
                                android:hint="Prénom"
                                android:paddingHorizontal="16dp"
                                android:textSize="14sp"
                                android:textColor="#1A2A3A"
                                android:inputType="textPersonName" />
                        </LinearLayout>

                        <!-- Nom -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                    android:src="@android:drawable/ic_menu_myplaces" app:tint="#009688"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp" android:text="Nom"
                                    android:textColor="#009688" android:textSize="12sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <EditText
                                android:id="@+id/etLastName"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/search_bg"
                                android:backgroundTint="#F5F5F5"
                                android:hint="Nom"
                                android:paddingHorizontal="16dp"
                                android:textSize="14sp"
                                android:textColor="#1A2A3A"
                                android:inputType="textPersonName" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Téléphone -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp"
                            android:src="@android:drawable/ic_menu_call" app:tint="#009688"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="4dp" android:text="Téléphone"
                            android:textColor="#009688" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/search_bg"
                        android:backgroundTint="#F5F5F5"
                        android:hint="+216 XX XXX XXX"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp"
                        android:textColor="#1A2A3A"
                        android:inputType="phone" />

                    <!-- Date de naissance -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp"
                            android:src="@android:drawable/ic_menu_my_calendar" app:tint="#009688"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="4dp" android:text="Date de naissance"
                            android:textColor="#009688" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <EditText
                        android:id="@+id/etDob"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/search_bg"
                        android:backgroundTint="#F5F5F5"
                        android:hint="JJ/MM/AAAA"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp"
                        android:textColor="#1A2A3A"
                        android:inputType="date" />

                    <!-- Hidden original etGender to not break any existing code -->
                    <EditText
                        android:id="@+id/etGender"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <!-- Genre Segmented Control Buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp"
                            android:src="@android:drawable/ic_menu_myplaces" app:tint="#009688"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="4dp" android:text="Genre"
                            android:textColor="#009688" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="14dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/btnGenderMale"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_gender_inactive"
                            android:gravity="center"
                            android:text="Homme"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            android:clickable="true"
                            android:focusable="true"/>
                        <TextView
                            android:id="@+id/btnGenderFemale"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_gender_inactive"
                            android:gravity="center"
                            android:text="Femme"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            android:clickable="true"
                            android:focusable="true"/>
                        <TextView
                            android:id="@+id/btnGenderOther"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_gender_inactive"
                            android:gravity="center"
                            android:text="Autre"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <!-- Adresse -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp"
                            android:src="@android:drawable/ic_menu_mapmode" app:tint="#009688"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="4dp" android:text="Adresse / Ville"
                            android:textColor="#009688" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <EditText
                        android:id="@+id/etAddress"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/search_bg"
                        android:backgroundTint="#F5F5F5"
                        android:hint="Votre adresse"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp"
                        android:textColor="#1A2A3A"
                        android:inputType="textPostalAddress" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECTION : COMPTE -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_dialog_email"
                            app:tint="#009688" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="COMPTE"
                            android:textColor="#00796B"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <!-- Email -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp"
                            android:src="@android:drawable/ic_dialog_email" app:tint="#009688"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="4dp" android:text="Email"
                            android:textColor="#009688" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="18dp"
                        android:background="@drawable/search_bg"
                        android:backgroundTint="#F5F5F5"
                        android:focusable="false"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="16dp"
                        android:textColor="#1A2A3A"
                        android:textSize="14sp" />

                    <!-- Hidden original etConsultationCount to not break any existing code -->
                    <EditText
                        android:id="@+id/etConsultationCount"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <!-- Consultations (lecture seule - Custom Banner) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp"
                            android:src="@android:drawable/ic_menu_info_details" app:tint="#009688"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="4dp" android:text="Consultations effectuées"
                            android:textColor="#009688" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_label_light_teal"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#009688"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_chat"
                                app:tint="#FFFFFF" />
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvConsultationCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#009688"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="consultation(s) au total"
                                android:textColor="#00796B"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECTION : INFORMATIONS MÉDICALES -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_info_details"
                            app:tint="#009688" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="INFORMATIONS MÉDICALES"
                            android:textColor="#00796B"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <!-- Groupe sanguin -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp"
                            android:src="@android:drawable/ic_menu_info_details" app:tint="#E74C3C"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="4dp" android:text="Groupe sanguin"
                            android:textColor="#009688" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <EditText
                        android:id="@+id/etBloodType"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/search_bg"
                        android:backgroundTint="#F5F5F5"
                        android:hint="A+, B-, O+, AB+..."
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp"
                        android:textColor="#1A2A3A"
                        android:inputType="textCapCharacters" />

                    <!-- Allergies -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp"
                            android:src="@android:drawable/ic_menu_info_details" app:tint="#E67E22"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="4dp" android:text="Allergies connues"
                            android:textColor="#009688" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <EditText
                        android:id="@+id/etAllergies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/search_bg"
                        android:backgroundTint="#F5F5F5"
                        android:hint="ex. Pénicilline, Arachides, Aucune"
                        android:padding="16dp"
                        android:textSize="14sp"
                        android:textColor="#1A2A3A"
                        android:inputType="textMultiLine"
                        android:minLines="2" />

                    <!-- Antécédents médicaux -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp"
                            android:src="@android:drawable/ic_menu_info_details" app:tint="#3498DB"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="4dp" android:text="Antécédents médicaux"
                            android:textColor="#009688" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <EditText
                        android:id="@+id/etMedicalHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/search_bg"
                        android:backgroundTint="#F5F5F5"
                        android:hint="Vos antécédents médicaux..."
                        android:padding="16dp"
                        android:textSize="14sp"
                        android:textColor="#1A2A3A"
                        android:inputType="textMultiLine"
                        android:minLines="2" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- BOUTON ENREGISTRER (fixé en bas) -->
    <Button
        android:id="@+id/btnSaveProfile"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#00796B"
        android:fontFamily="sans-serif-medium"
        android:text="Enregistrer les modifications"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
