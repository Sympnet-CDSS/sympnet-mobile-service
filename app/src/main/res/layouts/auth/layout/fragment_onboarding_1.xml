<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onboarding_bg_1">

    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"
        android:alpha="0.08"
        android:background="@drawable/shape_circle_white" />

    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-40dp"
        android:layout_marginBottom="120dp"
        android:alpha="0.06"
        android:background="@drawable/shape_circle_white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <!-- Logo de l'app -->
        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginBottom="48dp">

            <View
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:alpha="0.15"
                android:background="@drawable/shape_circle_white" />

            <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:src="@mipmap/ic_launcher" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/shape_tag_white"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="IA · MÉDICAL · CONFIDENTIEL"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Votre Santé,\nNotre Priorité"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp" />

        <View
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/shape_divider_white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="Bienvenue sur SympNet, votre assistant médical intelligent disponible 24h/24 pour vous accompagner."
            android:textColor="#CCffffff"
            android:textSize="15sp" />

    </LinearLayout>

</FrameLayout>